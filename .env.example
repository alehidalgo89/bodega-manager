# ============================================
# BODEGA DE CANDINHO - CONFIGURACIÓN
# ============================================

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/bodega_candinho

# Puerto del Servidor
PORT=5000

# Entorno
NODE_ENV=production

# URL de la API (para el frontend)
REACT_APP_API_URL=http://localhost:5000

# Configuración de la Bodega
BODEGA_NOMBRE=Bodega de Candinho
BODEGA_UBICACION=Ciudad del Este, Paraguay
